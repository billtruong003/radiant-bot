# ============================================================================
# Radiant Tech Sect Bot — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Discord credentials --------------------------------------------------
# Get these from https://discord.com/developers/applications
# DISCORD_TOKEN: Bot tab → Reset Token → copy
# DISCORD_CLIENT_ID: General Information → Application ID
# DISCORD_GUILD_ID: right-click your server (Developer Mode on) → Copy Server ID
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
DISCORD_GUILD_ID=your-test-guild-id-here

# --- Runtime --------------------------------------------------------------
# NODE_ENV: development | production
# LOG_LEVEL: trace | debug | info | warn | error | fatal
NODE_ENV=development
LOG_LEVEL=debug

# --- Storage (custom WAL + Snapshot) --------------------------------------
# DATA_DIR: where wal.jsonl and snapshot.json live
# SNAPSHOT_INTERVAL_MS: how often the snapshot timer fires (default 1h)
# WAL_FSYNC: true in production (durable, ~5ms/write), false in dev (faster)
DATA_DIR=./data
SNAPSHOT_INTERVAL_MS=3600000
WAL_FSYNC=true

# --- Admin allow-list -----------------------------------------------------
# Comma-separated Discord user IDs that have super-admin commands (no role check).
ADMIN_USER_IDS=

# --- GitHub backup --------------------------------------------------------
# BACKUP_GITHUB_REPO: "username/private-backup-repo"
# BACKUP_GITHUB_TOKEN: GitHub PAT with `repo` scope only (no other perms)
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=

# --- Health check endpoint ------------------------------------------------
# HEALTH_PORT: HTTP port for /health (UptimeRobot probes). Set to 0 to
# disable. Default 0 (dev), set 3030 in production.
# NOTE: /api/agent/* (Lucy) cũng phục vụ trên cổng này -> phải >0 để bật.
HEALTH_PORT=0

# --- Lucy agent control API ----------------------------------------------
# AGENT_HMAC_SECRET: secret HMAC cho POST /api/agent/post + /api/agent/channel
# (Lucy hub điều khiển Aki: đẩy báo cáo vào kênh, tạo kênh/thread).
# Empty = tắt (503). Đặt CÙNG giá trị với RADIANT_BOT_AGENT_SECRET bên Lucy hub.
# Tạo: openssl rand -hex 32
AGENT_HMAC_SECRET=

# --- Aki AI helper (Phase 15: chạy 100% model free, KHÔNG còn xAI Grok) ----
# XAI_API_KEY: @deprecated — Grok đã bị cắt hoàn toàn, không còn ai đọc.
# Aki chọn model theo task trong src/modules/llm/router.ts.
XAI_API_KEY=
# Trần output mỗi câu trả lời. Free-tier nên sizing theo độ hữu ích, không
# theo giá; model reasoning còn tiêu một phần vào chain-of-thought ẩn.
AKI_MAX_OUTPUT_TOKENS=2000
# Trần chi phí/ngày. Từ Phase 15 luôn = 0 nên gần như vô hiệu, giữ để
# analytics + admin surface còn chạy và để re-introduce model trả phí an toàn.
AKI_DAILY_BUDGET_USD=2.0

# --- LLM providers (router: src/modules/llm/router.ts) --------------------
# Rỗng = provider bị bỏ qua trong chuỗi fallback (không phải lỗi).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENCODE_ZEN_API_KEY=

# --- Phase 15: kho tri thức thành viên ------------------------------------
# Suy luận chân dung từng thành viên từ chat công khai rồi đăng digest vào
# #bot-log. MẶC ĐỊNH TẮT — nó lập hồ sơ người thật, nên phải bật tường minh.
MEMBER_PROFILING_ENABLED=false
# Học + nội suy chân dung: HÀNG NGÀY 09:00 (giờ VN).
MEMBER_PROFILING_CRON=0 9 * * *
# Analytics hoạt động: HÀNG TUẦN, CN 20:00 (giờ VN) — trùng nhịp bảng xếp
# hạng tuần để ban quản lý chỉ phải đọc 1 lần.
GROUP_ANALYTICS_CRON=0 20 * * 0

# --- Phase 12 Lát 9 — docs threads pipeline -------------------------------
# HMAC cho POST /api/contribute. Rỗng = tắt endpoint (503), /contribute-doc
# vẫn chạy. Tạo: openssl rand -hex 32
DOCS_HMAC_SECRET=

# --- Phase 13 Lát A — Radiant Arena bridge --------------------------------
# ARENA_ENABLED=false thì /arena báo "chưa bật", requestRoom() trả mock,
# /api/arena/result trả 503. Chỉ bật khi Colyseus thật sự chạy.
ARENA_ENABLED=false
ARENA_COLYSEUS_URL=http://localhost:2567
# 2 secret TÁCH BIỆT có chủ đích: lộ 1 bên không kéo theo bên kia.
ARENA_TOKEN_SECRET=
ARENA_RESULT_SECRET=

# --- Phase 16: kho tin nhắn tìm kiếm được -------------------------------
# Lưu nội dung tin nhắn vào SQLite để ban quản lý tra "X từng nói gì về Y".
# MẶC ĐỊNH TẮT — đây là lưu trữ hội thoại của người thật, phải bật tường minh.
# Quyền tra: CHỈ Chưởng Môn + Tiên Nhân (xem CHAT_SEARCH_ROLE_NAMES).
ARCHIVE_ENABLED=false
# Giữ bao nhiêu ngày rồi tự xoá. Lưu vĩnh viễn là rủi ro, không phải tính năng.
ARCHIVE_RETENTION_DAYS=90

# --- Phase 18: Aki tra cứu internet --------------------------------------
# Tavily API key. Rỗng = Aki không có internet, vẫn trả lời bằng kiến thức
# sẵn có + ngữ cảnh server (không lỗi, chỉ là không tra được).
TAVILY_API_KEY=
